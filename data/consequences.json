{
  // OSF Defeat — data-driven outcome rules.
  //
  // When an actor is defeated, the framework first asks any registered C++ outcome providers,
  // then evaluates these rules top-to-bottom and uses the FIRST whose "class" matches (a missing
  // "class" or "*" matches anything). If no rule matches, the built-in default applies.
  //
  //   class            : "Hostile" | "Crew" | "Security" | "Civilian" | "Unknown" | "*"  (omit = "*")
  //   outcome.disposition : "release" (auto-recover) | "hold" (stay down until rescued) | "default"
  //   outcome.recoverySeconds : for "release", REAL seconds until recovery (-1 = framework beat).
  //                             Converted to game-time, so it pauses with the game and scales with
  //                             sleep/wait.
  //
  // A rule may also carry "consequences": effects that fire when the rule matches a defeat:
  //   { "type": "event", "tag": "<name>" }     broadcasts kOnConsequenceMessage with that tag, for a
  //                                            consumer mod to act on (capture, ransom, loot, ...).
  //   { "type": "log",   "message": "<text>" } writes to the SFSE log (handy for testing the path).
  // Example:
  //   { "class": "Hostile", "outcome": { "disposition": "hold" },
  //     "consequences": [ { "type": "event", "tag": "osf_capture" } ] }
  //
  // This default file reproduces the built-in behavior (everyone auto-recovers after the ~8s beat)
  // and authors no consequences. Edit it to author outcomes and effects.
  "version": 1,
  "rules": [
    {
      "class": "Hostile",
      "outcome": { "disposition": "release", "recoverySeconds": -1.0 }
    },
    {
      "class": "*",
      "outcome": { "disposition": "release", "recoverySeconds": -1.0 }
    }
  ]
}
