{
  "version": 2,

  // Central user tuning: override any installed consequence by its stable "id", without editing
  // the pack's own files (which mod managers overwrite on update). Supported per-consequence
  // keys: "enabled" (bool), "weight" (int >= 1), "priority" (int).
  //
  // Example:
  //   "consequences": {
  //     "some-pack.human_scene":                { "enabled": true, "weight": 3 },
  //     "osfdefeat.default.down_then_recover": { "weight": 1 }
  //   }
  "consequences": {}
}
